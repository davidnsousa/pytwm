# Colors for dialog, in every program (pytwm and bashrc_extras set DIALOGRC to this
# file): light text on the terminal's own dark background, blue for names and the
# selected line, in the terminal's theme colors.

use_shadow = OFF
use_colors = ON

screen_color = (WHITE,DEFAULT,OFF)
shadow_color = (BLACK,BLACK,OFF)
dialog_color = (WHITE,DEFAULT,OFF)
title_color = (BLUE,DEFAULT,ON)
border_color = (BLUE,DEFAULT,OFF)
border2_color = border_color
button_active_color = (BLACK,BLUE,ON)
button_inactive_color = dialog_color
button_key_active_color = button_active_color
button_key_inactive_color = (YELLOW,DEFAULT,ON)
button_label_active_color = button_active_color
button_label_inactive_color = (WHITE,DEFAULT,ON)
inputbox_color = dialog_color
inputbox_border_color = border_color
inputbox_border2_color = border_color
searchbox_color = dialog_color
searchbox_title_color = title_color
searchbox_border_color = border_color
searchbox_border2_color = border_color
position_indicator_color = title_color
menubox_color = dialog_color
menubox_border_color = border_color
menubox_border2_color = border_color
item_color = dialog_color
item_selected_color = button_active_color
tag_color = (BLUE,DEFAULT,ON)
tag_selected_color = button_active_color
tag_key_color = (YELLOW,DEFAULT,ON)
tag_key_selected_color = button_active_color
check_color = dialog_color
check_selected_color = button_active_color
uarrow_color = (GREEN,DEFAULT,ON)
darrow_color = uarrow_color
itemhelp_color = (WHITE,DEFAULT,OFF)
